{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "games": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "loungeChat": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "userInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$inviteId": {
          ".write": "auth != null && (auth.uid == $uid || newData.child('fromUid').val() == auth.uid || data.child('fromUid').val() == auth.uid)"
        }
      }
    }
  }
}
